{
  "name": "scholsey-monorepo",
  "version": "1.0.0",
  "description": "Phone tracking system with real-time location and battery monitoring",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd web && npm run dev",
    "install:all": "cd backend && npm install && cd ../web && npm install",
    "prisma:studio": "cd backend && npm run prisma:studio",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:migrate": "cd backend && npm run prisma:migrate"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
